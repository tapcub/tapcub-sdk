{
  "name": "@tapcub/miniprogram",
  "version": "0.1.0",
  "description": "TapCub SDK for mini programs (WeChat / Alipay / Douyin): unified API, identity and consent, persistent queue, remote config",
  "license": "MIT",
  "type": "module",
  "homepage": "https://tapcub.com",
  "repository": { "type": "git", "url": "git+https://github.com/tapcub/tapcub-sdk.git", "directory": "packages/miniprogram" },
  "keywords": ["tapcub", "analytics", "sdk", "miniprogram", "wechat", "alipay", "douyin", "tracking"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "miniprogram": "dist",
  "sideEffects": false,
  "exports": {
    ".": { "tapcub-source": "./src/index.ts", "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./wx": { "tapcub-source": "./src/wx.ts", "types": "./dist/wx.d.ts", "import": "./dist/wx.js", "require": "./dist/wx.cjs" },
    "./my": { "tapcub-source": "./src/my.ts", "types": "./dist/my.d.ts", "import": "./dist/my.js", "require": "./dist/my.cjs" },
    "./tt": { "tapcub-source": "./src/tt.ts", "types": "./dist/tt.d.ts", "import": "./dist/tt.js", "require": "./dist/tt.cjs" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup && node ../../scripts/sdk-size-check.mjs miniprogram",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.mjs"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
