{
  "name": "super_props_merge_persist_and_reject_dollar_keys",
  "cfg": {
    "t": 3,
    "i": 1,
    "cs": {
      "req": false
    }
  },
  "steps": [
    {
      "call": "init"
    },
    {
      "call": "registerSuperProps",
      "args": [
        {
          "plan": "pro",
          "$bad": "x"
        }
      ]
    },
    {
      "call": "track",
      "args": [
        "a"
      ]
    },
    {
