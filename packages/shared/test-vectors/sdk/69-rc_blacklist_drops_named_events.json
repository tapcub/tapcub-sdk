  "cfg": {
    "t": 3,
    "i": 1,
    "cs": {
      "req": false
    },
    "rc": {
      "blacklist": [
        "secret",
        "$mp_show"
      ]
    }
  },
  "steps": [
    {
      "lifecycle": "launch",
      "info": {
        "scene": 1001
      }
    },
    {
      "call": "init"
    },
    {
