{
  "name": "trackScreen_manual_page_view",
  "cfg": {
    "t": 3,
    "i": 1,
    "cs": {
      "req": false
    }
  },
  "steps": [
    {
      "call": "init"
    },
    {
      "call": "trackScreen",
      "args": [
        "Goods",
