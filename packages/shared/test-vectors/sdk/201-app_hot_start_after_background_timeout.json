{
  "name": "app_hot_start_after_background_timeout",
  "suite": "app",
  "platform": "android",
  "cfg": { "t": 3, "i": 1, "cs": { "req": false } },
  "config": { "sessionTimeoutSec": 1 },
  "steps": [
    { "call": "init" },
    { "lifecycle": "launch" },
    { "lifecycle": "hide" },
    { "advance": 16000 },
    { "lifecycle": "show" },
    { "call": "flush" }
  ],
  "expect": {
    "itemNames": ["$app_install", "$app_start", "$app_end", "$app_start"]
  }
}
