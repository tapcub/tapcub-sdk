{
  "name": "@tapcub/uni-app",
  "version": "0.1.0",
  "description": "TapCub for uni-app: mini program targets use @tapcub/miniprogram, App targets use @tapcub/app-sdk",
  "license": "MIT",
  "type": "module",
  "homepage": "https://tapcub.com",
  "repository": { "type": "git", "url": "git+https://github.com/tapcub/tapcub-sdk.git", "directory": "packages/uni-app" },
  "keywords": ["tapcub", "analytics", "sdk", "uni-app", "uniapp", "miniprogram", "tracking"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./mp": { "types": "./dist/mp.d.ts", "import": "./dist/mp.js", "require": "./dist/mp.cjs" },
    "./app": { "types": "./dist/app.d.ts", "import": "./dist/app.js", "require": "./dist/app.cjs" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=tapcub-source --experimental-strip-types --test test/*.test.mjs"
  },
  "dependencies": {
    "@tapcub/app-sdk": "workspace:^",
    "@tapcub/miniprogram": "workspace:^"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
